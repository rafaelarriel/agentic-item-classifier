# Preencha com uma chave de projeto. Nunca versione o arquivo .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

CLASSIFIER_BATCH_SIZE=20
MAX_CONCURRENT_BATCHES=5
CLASSIFIER_TIMEOUT_SECONDS=45
CLASSIFIER_MAX_RETRIES=2
CLASSIFIER_RETRY_BASE_SECONDS=1
MAX_ITEMS_PER_REQUEST=100

MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://localhost:8001/mcp

API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
